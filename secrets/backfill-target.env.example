# Template for scripts/backfill-tax-brackets.sh
#
# Copy this to secrets/backfill-target.env (gitignored) and fill in the
# pf-rates instance you want to backfill against + the API key it expects.
#
# To hit your LOCAL dev instance instead (writes to your local Postgres,
# already the default when pf-rates isn't overridden):
#   PF_RATES_BASE_URL=http://localhost:8001
#   PF_RATES_API_KEY=<the PF_RATES_API_KEY value from ../.env>
#
# To hit the deployed Cloud Run instance (writes to whatever DB it's
# configured with in Secret Manager -- Neon in this project):
#   PF_RATES_BASE_URL=https://<your-cloud-run-url>.run.app
#   PF_RATES_API_KEY=<the PF_RATES_API_KEY secret value in Secret Manager>
PF_RATES_BASE_URL=http://localhost:8001
PF_RATES_API_KEY=change-me-before-use
