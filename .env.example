# Required
# Database is managed by pf-db (shared with all Personal Finance microservices).
# Run `make db-up` in the pf-db repo before starting this service.
PF_DATABASE_URL=postgresql+asyncpg://pf_db:pf_db@localhost:5432/pf_db
PF_RATES_API_KEY=change-me-before-use

# Path to the pf-db repository — used by integration tests to read SQL fixtures.
# Default assumes pf-db is a sibling directory (../pf-db). Override if needed.
PF_DB_PATH=../pf-db

# Tooling — corporate pip/npm registries (used by make install/check on VPN)
CORPORATIVE_PIP_INDEX=https://pypi.ci.artifacts.corporative.com/artifactory/api/pypi/pythonhosted-pypi-release-remote/simple
CORPORATIVE_NPM_REGISTRY=https://npm.ci.artifacts.corporative.com/artifactory/api/npm/external-npm
CORPORATIVE_PROXY=http://sysproxy.corpo-rative.com:8080

# Optional — provider timeouts and base URLs
FINANCIAL_DATA_RATE_PROVIDER_TIMEOUT_SECONDS=10
# Outbound HTTP proxy for provider calls (BCCH/SII/mindicador). Leave blank
# to disable — an empty string is treated the same as unset (see config.py).
# Deploy pipeline explicitly forces this to empty on Cloud Run (no proxy
# needed there); only relevant for local dev behind a corporate proxy.
FINANCIAL_DATA_HTTP_PROXY=
FINANCIAL_DATA_MINDICADOR_BASE_URL=https://mindicador.cl/api
FINANCIAL_DATA_SII_BASE_URL=https://www.sii.cl
FINANCIAL_DATA_BCCH_API_BASE_URL=https://si3.bcentral.cl/SieteRestWS/SieteRestWS.ashx

# Optional — BCCH credentials (leave blank to disable)
FINANCIAL_DATA_BCCH_API_USER=
FINANCIAL_DATA_BCCH_API_PASSWORD=

# Optional — BCCH series codes
FINANCIAL_DATA_BCCH_SERIES_UF=
FINANCIAL_DATA_BCCH_SERIES_USD=
FINANCIAL_DATA_BCCH_SERIES_EUR=
FINANCIAL_DATA_BCCH_SERIES_UTM=
FINANCIAL_DATA_BCCH_SERIES_IPC_CL=

# Optional — Google Drive CSV export (POST /exports/financial-data)
# Leave blank to disable; the endpoint returns 503 until configured.
# Authentication uses Application Default Credentials (ADC), NOT a stored
# token here -- locally, run `gcloud auth application-default login`; in
# production, Cloud Run's attached service account provides this
# automatically. See docs/google-drive-credentials-setup.md for the full
# picture, including the accepted trade-off (a service account can update
# an existing Drive file but not create a brand-new one).
PF_RATES_GDRIVE_EXPORT_FOLDER_ID=
